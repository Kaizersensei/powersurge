if(POLICY CMP0207)
 cmake_policy(SET CMP0207 NEW)
endif()
# Test-ready Windows assembly; no Python or source restaging. Signed: President.
if(NOT WIN32)
 message(FATAL_ERROR "This first portable target is Windows-only")
endif()
if(NOT EXISTS "${PS_EXE}")
 message(FATAL_ERROR "Build the engine first")
endif()
# Refuse an incomplete selected content pack before replacing any executable/artifact.
file(STRINGS "${PS_SOURCE}/labs/required-assets.txt" required_assets)
foreach(asset IN LISTS required_assets)
 string(STRIP "${asset}" asset)
 if(asset STREQUAL "" OR asset MATCHES "^#")
  continue()
 endif()
 if(NOT EXISTS "${PS_SOURCE}/labs/content/${asset}" OR IS_DIRECTORY "${PS_SOURCE}/labs/content/${asset}")
  message(FATAL_ERROR "Required runtime content is missing: ${asset}. Current portable output is preserved.")
 endif()
endforeach()
file(MAKE_DIRECTORY "${PS_OUTPUT}")
# Keep an already-tested stripped candidate byte-identical across packaging calls.
# GNU PE stripping can refresh header bytes; do not regenerate it for an unchanged input.
set(candidate_current false)
if(DEFINED PS_STRIP)
 file(SHA256 "${PS_EXE}" source_digest)
 if(EXISTS "${PS_OUTPUT}/.strip-state" AND EXISTS "${PS_OUTPUT}/powersurge.exe")
  file(SHA256 "${PS_OUTPUT}/powersurge.exe" candidate_digest)
  file(READ "${PS_OUTPUT}/.strip-state" previous_strip)
  if(previous_strip STREQUAL "${source_digest}:${candidate_digest}")
   set(candidate_current true)
  endif()
 endif()
endif()
if(NOT candidate_current)
 file(COPY_FILE "${PS_EXE}" "${PS_OUTPUT}/powersurge.exe" ONLY_IF_DIFFERENT)
 if(DEFINED PS_STRIP)
  execute_process(COMMAND "${PS_STRIP}" --strip-debug --strip-unneeded "${PS_OUTPUT}/powersurge.exe" RESULT_VARIABLE stripped)
  if(NOT stripped EQUAL 0)
   message(FATAL_ERROR "Cannot prepare public candidate without debug symbols")
  endif()
  file(SHA256 "${PS_OUTPUT}/powersurge.exe" candidate_digest)
  file(WRITE "${PS_OUTPUT}/.strip-state" "${source_digest}:${candidate_digest}")
 endif()
endif()
# Engine and demonstration assets must match. Upstream startup content is not this preview.
file(COPY "${PS_SOURCE}/labs/content/" DESTINATION "${PS_OUTPUT}")
file(COPY "${PS_SOURCE}/LICENSE" DESTINATION "${PS_OUTPUT}")
file(COPY "${PS_SOURCE}/labs" DESTINATION "${PS_OUTPUT}")
file(WRITE "${PS_OUTPUT}/powersurge-preview.ini" "[preview]\nstartup=frontend\n")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${PS_OBJDUMP}")
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${PS_EXE}"
 DIRECTORIES "${PS_DLLDIR}"
 PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
 RESOLVED_DEPENDENCIES_VAR deps UNRESOLVED_DEPENDENCIES_VAR missing)
if(missing)
 message(FATAL_ERROR "Unresolved runtime dependencies: ${missing}")
endif()
foreach(dep IN LISTS deps)
 file(TO_CMAKE_PATH "${dep}" normalized)
 string(TOLOWER "${normalized}" lower)
 if(NOT lower MATCHES "/windows/")
  file(COPY "${dep}" DESTINATION "${PS_OUTPUT}")
 endif()
endforeach()
file(COPY "${PS_SOURCE}/labs/content/licenses/" DESTINATION "${PS_OUTPUT}/licenses")
file(COPY_FILE "${PS_SOURCE}/licenses/runtime-dependency-packages.json" "${PS_OUTPUT}/dependency-packages.json" ONLY_IF_DIFFERENT)
file(COPY "${PS_SOURCE}/docs/LAB_RUNS.md" DESTINATION "${PS_OUTPUT}")
file(SHA256 "${PS_OUTPUT}/powersurge.exe" digest)
set(info [=[{
  "engine":"PowerSurge",
  "status":"development-test-build",
  "binary_sha256":"@digest@",
  "signed":"President"
}
]=])
string(CONFIGURE "${info}" info @ONLY)
file(WRITE "${PS_OUTPUT}/build-info.json" "${info}")
message(STATUS "Portable test build: ${PS_OUTPUT}")
