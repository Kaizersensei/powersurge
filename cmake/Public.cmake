# Explicit promotion of tested public files; no private-run copying. Signed: President.
cmake_minimum_required(VERSION 3.31)
foreach(required PS_SOURCE PS_INPUT PS_PUBLIC_ROOT)
 if(NOT DEFINED ${required})
  message(FATAL_ERROR "Missing ${required}")
 endif()
endforeach()
file(READ "${PS_SOURCE}/public/accepted.json" accepted)
foreach(key promotion binary_sha256 source_sha256 content_sha256)
 string(JSON ${key} GET "${accepted}" "${key}")
endforeach()
if(NOT promotion MATCHES "^[a-z0-9][a-z0-9-]+$")
 message(FATAL_ERROR "Invalid public promotion ID")
endif()
function(safe_relative path)
 string(FIND "${path}" "\\" backslash)
 if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)[.][.](/|$)" OR NOT backslash EQUAL -1 OR path STREQUAL "")
  message(FATAL_ERROR "Unsafe public file path: ${path}")
 endif()
endfunction()
function(fingerprint base result)
 set(input_files ${ARGN})
 list(SORT input_files)
 set(text "")
 foreach(path IN LISTS input_files)
  safe_relative("${path}")
  if(IS_SYMLINK "${base}/${path}")
   message(FATAL_ERROR "Links are not public package inputs: ${path}")
  endif()
  file(SHA256 "${base}/${path}" digest)
  string(APPEND text "${path}:${digest}\n")
 endforeach()
 string(SHA256 digest "${text}")
 set(${result} "${digest}" PARENT_SCOPE)
endfunction()
# Recompute the exact allowlisted source set; accepted.json cannot hash itself.
file(STRINGS "${PS_SOURCE}/public/source-roots.txt" roots)
set(source_files "")
foreach(path IN LISTS roots)
 safe_relative("${path}")
 if(IS_SYMLINK "${PS_SOURCE}/${path}")
  message(FATAL_ERROR "Linked source root refused")
 endif()
 if(IS_DIRECTORY "${PS_SOURCE}/${path}")
  file(GLOB_RECURSE children LIST_DIRECTORIES false RELATIVE "${PS_SOURCE}" "${PS_SOURCE}/${path}/*")
  list(APPEND source_files ${children})
 else()
  list(APPEND source_files "${path}")
 endif()
endforeach()
list(REMOVE_DUPLICATES source_files)
list(SORT source_files)
set(hash_files ${source_files})
list(REMOVE_ITEM hash_files public/accepted.json)
fingerprint("${PS_SOURCE}" actual_source ${hash_files})
file(GLOB_RECURSE content_files LIST_DIRECTORIES false RELATIVE "${PS_SOURCE}/labs/content" "${PS_SOURCE}/labs/content/*")
fingerprint("${PS_SOURCE}/labs/content" actual_content ${content_files})
file(SHA256 "${PS_INPUT}/powersurge.exe" actual_binary)
if(NOT actual_binary STREQUAL binary_sha256 OR NOT actual_source STREQUAL source_sha256 OR NOT actual_content STREQUAL content_sha256)
 message(FATAL_ERROR "Public promotion refused: source, content or executable differs from acceptance. Private portable output is preserved. Source ${actual_source}; content ${actual_content}; binary ${actual_binary}.")
endif()
# Copy only accepted bytes. Arbitrary extra files in the developer build are never inputs.
string(JSON runtime_count LENGTH "${accepted}" runtime)
if(runtime_count LESS 1)
 message(FATAL_ERROR "Empty accepted runtime")
endif()
math(EXPR last "${runtime_count}-1")
set(runtime_files "")
foreach(index RANGE 0 ${last})
 string(JSON path GET "${accepted}" runtime ${index} path)
 string(JSON expected GET "${accepted}" runtime ${index} sha256)
 safe_relative("${path}")
 if(IS_SYMLINK "${PS_INPUT}/${path}" OR path MATCHES "(^|/)(private|research|lab-reports|lab-kept|user|userdata|[.]git)(/|$)" OR path MATCHES "[.](bak|tmp|progress|log|bsp|bsl)$")
  message(FATAL_ERROR "Private runtime input refused: ${path}")
 endif()
 file(SHA256 "${PS_INPUT}/${path}" actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Accepted runtime input changed: ${path}")
 endif()
 if(path MATCHES "[.](json|md|ini|txt)$")
  file(READ "${PS_INPUT}/${path}" text)
  if(text MATCHES "[A-Z]:/" OR text MATCHES "[A-Z]:\\\\")
   message(FATAL_ERROR "Private local path in runtime metadata: ${path}")
  endif()
 endif()
 if(path MATCHES "[.](exe|dll)$")
  file(READ "${PS_INPUT}/${path}" binary HEX)
  set(private_prefixes "${PS_SOURCE}")
  if(DEFINED ENV{USERPROFILE})
   list(APPEND private_prefixes "$ENV{USERPROFILE}")
  endif()
  foreach(prefix IN LISTS private_prefixes)
   file(TO_CMAKE_PATH "${prefix}" forward)
   string(REPLACE "/" "\\" backward "${forward}")
   foreach(variant "${forward}" "${backward}")
    string(HEX "${variant}" encoded)
    string(FIND "${binary}" "${encoded}" found)
    if(NOT found EQUAL -1)
     message(FATAL_ERROR "Private build path embedded in distribution binary: ${path}. Rebuild with file-prefix maps and strip symbols.")
    endif()
   endforeach()
  endforeach()
 endif()
 list(APPEND runtime_files "${path}")
endforeach()
list(REMOVE_DUPLICATES runtime_files)
foreach(path IN LISTS source_files)
 if(path MATCHES "(^|/)(private|research|out|lab-reports|lab-kept|[.]git)(/|$)" OR path STREQUAL "HANDOFF.md" OR path STREQUAL "CLAIMS.md" OR path MATCHES "[.](bak|tmp|progress)$")
  message(FATAL_ERROR "Private source input refused: ${path}")
 endif()
endforeach()
get_filename_component(public_root "${PS_PUBLIC_ROOT}" ABSOLUTE)
set(destination "${public_root}/${promotion}")
set(runtime "${destination}/runtime")
set(source_root "${destination}/source/PowerSurge")
# Never silently retain stale files, or replace a promotion with different acceptance.
if(EXISTS "${runtime}/accepted.json")
 file(READ "${runtime}/accepted.json" previous)
 if(NOT previous STREQUAL accepted)
  message(FATAL_ERROR "Immutable public promotion already exists; use a new ID")
 endif()
endif()
foreach(kind runtime source)
 if(kind STREQUAL "runtime")
  set(base "${runtime}")
  set(allowed ${runtime_files} accepted.json)
 else()
  set(base "${source_root}")
  set(allowed ${source_files})
 endif()
 file(GLOB_RECURSE existing LIST_DIRECTORIES false RELATIVE "${base}" "${base}/*")
 foreach(path IN LISTS existing)
  if(NOT path IN_LIST allowed OR IS_SYMLINK "${base}/${path}")
   message(FATAL_ERROR "Unexpected file in public assembly: ${kind}/${path}. Nothing was removed; use a clean promotion ID.")
  endif()
 endforeach()
endforeach()
# Validation above completes before any public write.
foreach(path IN LISTS runtime_files)
 get_filename_component(parent "${runtime}/${path}" DIRECTORY)
 file(MAKE_DIRECTORY "${parent}")
 file(COPY_FILE "${PS_INPUT}/${path}" "${runtime}/${path}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${PS_SOURCE}/public/accepted.json" "${runtime}/accepted.json")
foreach(path IN LISTS source_files)
 get_filename_component(parent "${source_root}/${path}" DIRECTORY)
 file(MAKE_DIRECTORY "${parent}")
 file(COPY_FILE "${PS_SOURCE}/${path}" "${source_root}/${path}" ONLY_IF_DIFFERENT)
endforeach()
file(ARCHIVE_CREATE OUTPUT "${destination}/PowerSurge-preview-windows-x64.zip" PATHS runtime FORMAT zip WORKING_DIRECTORY "${destination}")
file(ARCHIVE_CREATE OUTPUT "${destination}/PowerSurge-preview-source.zip" PATHS PowerSurge FORMAT zip WORKING_DIRECTORY "${destination}/source")
message(STATUS "Accepted public preview: ${destination}")
