  auto tick=[&](float x,float y,const TerrainInput& input){terrain_input(origin+x,origin+y,128,0,0,input);};
  tick(-900,-700,down);check(pending&&preview.valid,"Line mode did not create its live first-point preview");observe_terrain_input(up);check(pending&&previous_buttons==0,"UI release cancelled the anchor or retained a pressed button");tick(-300,-700,down);tick(-300,-700,up);check(!pending&&field.doc.strokes.size()==count+1&&field.doc.strokes.back().mode==1,"Line mode preview did not commit exactly once");
  shell_paint_action=0;mode=2;down.down[ALLEGRO_KEY_LSHIFT]=up.down[ALLEGRO_KEY_LSHIFT]=true;tick(-900,-256,down);observe_terrain_input(up);tick(-500,-256,down);tick(-500,-256,up);check(!pending&&field.doc.strokes.size()==count+2&&field.doc.strokes.back().mode==2,"Shift-click curve did not commit after a captured release");
  auto committed=cell::encode(field.doc);shell_paint_action=2;down.down.fill(false);up.down.fill(false);tick(std::nanf(""),-256,down);check(terrain_wait_release&&!pending&&!preview.valid&&cell::encode(field.doc)==committed,"Rejected line changed coverage or retained its pending anchor");tick(-1500,-100,down);check(!pending&&cell::encode(field.doc)==committed,"Held button retriggered after rejection");observe_terrain_input(up);check(!terrain_wait_release,"Release did not clear the rejection gate");
  mode=0;tick(-1500,-100,down);observe_terrain_input(up);tick(-1200,-100,down);tick(-1200,-100,up);check(!pending&&field.doc.strokes.size()==count+3,"Fresh straight line failed after a rejected input");history(true);check(field.doc.strokes.size()==count+2,"Committed line undo failed");history(false);check(field.doc.strokes.size()==count+3,"Committed line redo failed");check(read(path)==disk,"Line checks altered authoritative source");restore();check(cell::encode(field.doc)==document&&resource_hash()==hash,"Line checks did not restore the source geometry/visuals");return checks;
 }catch(const std::exception& e){try{restore();}catch(...){}if(error&&capacity)snprintf(error,capacity,"%s",e.what());return -1;}
