 int checks=0;auto original=field.doc,old_before=before,old_published=published;auto old_undo=undo_stack,old_redo=redo_stack;auto old_preview=preview;auto old_keys=keys;unsigned old_buttons=previous_buttons;int old_selected=selected,old_action=shell_paint_action,old_brush=brush,old_mode=mode;bool old_tool=tool,old_dirty=dirty,old_pending=pending,old_drag=drag,old_wait=terrain_wait_release;double old_curve=curve;
 auto same=[](const cell::Field& a,const cell::Field& b){if(a.blocks.size()!=b.blocks.size())return false;for(auto& p:a.blocks){auto n=b.blocks.find(p.first);if(n==b.blocks.end()||n->second.cells!=p.second.cells)return false;}return true;};
 auto restore=[&]{field.doc=original;field.rebuild();resolve_surface_cache();rebuild();before=old_before;published=old_published;undo_stack=old_undo;redo_stack=old_redo;preview=old_preview;keys=old_keys;previous_buttons=old_buttons;selected=old_selected;shell_paint_action=old_action;brush=old_brush;mode=old_mode;tool=old_tool;dirty=old_dirty;pending=old_pending;drag=old_drag;curve=old_curve;terrain_wait_release=old_wait;};
 try{
  auto check=[&](bool okay,const char* why){if(!okay)throw std::runtime_error(why);++checks;};
  check(active&&field.shape(8),"Line course attachment unavailable");auto disk=read(path),document=cell::encode(field.doc);auto hash=resource_hash();
  for(int size:{32,64,128}){
