  for(int kind=0;kind<3;++kind){auto next=large;cell::Stroke line{1,false,-1400,-1000,1400,-1000,128,kind,.5};next.doc.strokes.push_back(line);check(!next.paint(line).empty()&&next.blocks.size()>256,"Line mode refused on an expanded course");auto loaded=cell::Field{};loaded.doc=cell::decode(cell::encode(next.doc));loaded.rebuild();check(same(next,loaded),"Expanded curved course does not replay consistently");}
