   for(int x=int(radius)+1;x<256-int(radius);x+=8){int first=-255;while(first<511&&!square.sample(x,first))first+=2;double edge=.5*x-1.5*radius;check(first>=edge-1e-6&&first<=edge+cell::step+1e-6,"Square line has brush-sized stair steps rather than sample-sized raster edges");}
   check(square.sample(-radius+1,-radius+1)!=nullptr,"Square stroke lost its end corner");auto reverse=square;std::swap(reverse.doc.strokes[0].x,reverse.doc.strokes[0].u);std::swap(reverse.doc.strokes[0].y,reverse.doc.strokes[0].v);reverse.rebuild();check(same(square,reverse),"Stroke direction changes swept-square coverage");
   auto round=square;round.doc.shapes[0].preset="round";round.rebuild();check(!round.sample(-radius+1,-radius+1)&&round.sample(128,64),"Round linear stroke no longer forms a capsule");
  }
