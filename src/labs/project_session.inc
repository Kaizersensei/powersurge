// Durable roots share native scene/test control, never lab cleanup ownership. Signed: President.
namespace {
fs::path project_check_root;
void public_project_path(const fs::path& path){auto root=ps::project::plain(path);if(root.filename()=="powersurge.project.json")root=root.parent_path();if(ps::project::contains_path(fs::temp_directory_path()/"PowerSurge-labs-v1",root)&&!(project_check&&!project_check_root.empty()&&ps::project::contains_path(project_check_root,root)))throw std::runtime_error("Choose a project folder outside disposable lab storage; use Save project copy to preserve a laboratory");if(run.active&&ps::project::contains_path(run.folder,root))throw std::runtime_error("A project cannot be nested inside the current source/run folder");}
std::optional<Run> project_next;bool project_pending(){return project_next.has_value();}bool project_resume=false;std::string project_entry;
std::string bounded(const char* value,size_t limit,bool required){if(!value){if(required)throw std::runtime_error("Required project argument missing");return {};}size_t n=0;while(n<=limit&&value[n]){if(static_cast<unsigned char>(value[n])<32)throw std::runtime_error("Control character in project argument");++n;}if(n>limit||(required&&!n))throw std::runtime_error("Invalid project argument length");return std::string(value,n);}
Run project_prepare(const fs::path& root){Run candidate;candidate.project=ps::project::load(root);candidate.folder=candidate.project->root;candidate.original=run.active?run.original:fs::current_path();candidate.exe=run.exe;candidate.id="database";for(auto& file:fs::recursive_directory_iterator(ps::project::plain(candidate.folder/".powersurge")))if(link(file.path()))throw std::runtime_error("Linked project local state refused");ps::project::plain(candidate.folder/".powersurge/.lease");if(!take_lease_for(candidate,candidate.folder/".powersurge"))throw std::runtime_error("Project is already open in another process or is not writable");try{auto again=ps::project::load(root);if(again.baseline!=candidate.project->baseline)throw std::runtime_error("Project changed while opening");candidate.project=std::move(again);return candidate;}catch(...){release_lease_for(candidate);throw;}}
fs::path recent_file(){return run.exe.parent_path()/".userdata/project-history.json";}
std::vector<std::string> recent_paths(){std::vector<std::string> paths;auto path=recent_file();if(!fs::exists(path))return paths;auto j=ps::authoring::parse(ps::authoring::read_file(ps::project::plain(path)));if(j.at("format")!=1||!j.at("projects").is_array()||j["projects"].size()>10)throw std::runtime_error("Unknown project history preserved");for(auto& p:j["projects"]){if(!p.is_string()||p.get_ref<const std::string&>().size()>8192)throw std::runtime_error("Invalid project history");paths.push_back(p.get<std::string>());}return paths;}
void remember_project(){if(project_check)return;try{auto list=recent_paths();auto path=run.folder.u8string();list.erase(std::remove_if(list.begin(),list.end(),[&](auto& item){std::error_code ec;return fs::equivalent(fs::u8path(item),run.folder,ec)||item==path;}),list.end());list.insert(list.begin(),path);if(list.size()>10)list.resize(10);auto file=ps::project::plain(recent_file());fs::create_directories(file.parent_path());ps::authoring::atomic_file(file,ps::authoring::Json{{"format",1},{"projects",list}}.dump(2));}catch(const std::exception& e){bsl_shell_note("project",e.what(),1);}}
void project_start(const fs::path& root){public_project_path(root);auto next=project_prepare(root);run=take_run(next);project_entry=run.project->scene;configure_run(profile_for("database"),project_entry);project_resume=true;remember_project();std::printf("PowerSurge persistent project: %s\n",run.folder.u8string().c_str());}
bool project_apply(commandline_t* cmd){try{if(!bsl_host_begin_lab_run())throw std::runtime_error("Gameplay bindings survived teardown");if(!ps_hub_release_project())throw std::runtime_error("Unsaved project drafts prevented transition");finish_current();run=take_run(*project_next);project_next.reset();project_entry=run.project->scene;configure_run(profile_for("database"),project_entry);*cmd=commandline_parse(int(arguments.size()),pointers.data());run.embedded=true;project_resume=true;remember_project();return true;}catch(const std::exception& e){if(project_next){release_lease_for(*project_next);project_next.reset();}run.code=1;std::fprintf(stderr,"Project transition failed; source files preserved: %s\n",e.what());return false;}}
void project_tick(){if(project_resume&&!bsl_host_boot_busy()&&level_time()>=.05f&&bsl_shell_present()&&std::string(bsl_engine_level_file())==project_entry){project_resume=false;ps_hub_resume_authoring(true);bsl_shell_note("project","Persistent project opened. Source files stay in its chosen folder; tests remain disposable.",0);}}
void project_saved(){if(!run.project)return;auto world=ps::project::world(run.folder/"content");std::string entry;for(auto& j:ps::authoring::read_records([&](const std::string& p){return ps::authoring::read_file(run.folder/"content/database"/p);}))if(j.value("kind","")=="level"&&j.value("scene","")==bsl_engine_level_file())entry=j["id"].get<std::string>();if(!entry.empty())ps::project::save(*run.project,entry);bsl_shell_note("project",("Saved to "+run.folder.u8string()).c_str(),0);}
int project_storage_check();
}
extern "C" void ps_project_info(PsProjectInfo* info){if(!info)return;*info={};info->persistent=run.project.has_value();info->pending=project_next.has_value();info->generation=generation;if(run.project){snprintf(info->root,sizeof info->root,"%s",run.folder.u8string().c_str());snprintf(info->name,sizeof info->name,"%s",run.project->json["name"].get<std::string>().c_str());snprintf(info->identity,sizeof info->identity,"%s",run.project->json["id"].get<std::string>().c_str());}}
extern "C" int ps_project_recent(int index,char* path,unsigned capacity){try{auto list=recent_paths();if(index<0||size_t(index)>=list.size())return 0;if(path&&capacity)snprintf(path,capacity,"%s",list[size_t(index)].c_str());return int(list.size());}catch(...){return 0;}}
extern "C" int ps_project_request(const PsProjectRequest* request,PsProjectReply* output){PsProjectReply local{};auto& reply=output?*output:local;reply={};auto fail=[&](int code,const std::string& why){reply.status=code;snprintf(reply.message,sizeof reply.message,"%s",why.c_str());bsl_shell_note("project",why.c_str(),code==PS_TEST_FAILED?2:1);return code;};
 if(!request||request->version!=1||request->action<PS_PROJECT_NEW||request->action>PS_PROJECT_SAVE||request->generation!=generation)return fail(PS_TEST_INVALID,"Invalid or stale project request");if(project_next||owned_busy()||!pending_lab.empty()||project_resume||(ps_lab_automatic()&&!project_check))return fail(PS_TEST_UNAVAILABLE,"Finish the current test/transition before changing projects");BslShellState view{};bsl_shell_snapshot(&view);if(view.terrain_dirty||view.placements_dirty||ps_hub_has_drafts())return fail(PS_TEST_DIRTY,"Save terrain, placements and database drafts before changing project");
 try{if(request->action==PS_PROJECT_SAVE){if(!run.project)return fail(PS_TEST_UNAVAILABLE,"Use Save project copy to give this laboratory a permanent project folder");project_saved();reply.status=PS_TEST_ACCEPTED;snprintf(reply.message,sizeof reply.message,"Saved project settings and current entry.");return reply.status;}auto path=bounded(request->path,8192,true),name=bounded(request->name,128,request->action!=PS_PROJECT_OPEN);public_project_path(fs::u8path(path));if(request->action!=PS_PROJECT_OPEN){auto source=request->action==PS_PROJECT_NEW?run.exe.parent_path()/"labs/content":fs::u8path(asset_gamedir()?asset_gamedir():"");if(request->action==PS_PROJECT_COPY&&!run.active)return fail(PS_TEST_UNAVAILABLE,"Open a managed source project before copying");if(!fs::is_regular_file(source/"lab-content.marker"))return fail(PS_TEST_UNAVAILABLE,"Source runtime pack is unavailable");ps::project::create(source,fs::u8path(path),name,request->action==PS_PROJECT_NEW?"levels/cell-terrain.lev":bsl_engine_level_file());}auto prepared=project_prepare(fs::u8path(path));project_next=take_run(prepared);ps_hub_suspend_for_transition();engine_restart(nullptr);reply.status=PS_TEST_ACCEPTED;snprintf(reply.message,sizeof reply.message,"Project prepared; opening its permanent source folder.");return reply.status;}catch(const std::exception& e){if(project_next){release_lease_for(*project_next);project_next.reset();}return fail(PS_TEST_FAILED,e.what());}}
